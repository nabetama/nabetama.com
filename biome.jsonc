{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!.astro",
      "!!.cursor",
      // pnpm e2e のたびに上書きされる自動生成テストと出力
      "!!e2e/tests/generated",
      "!!e2e-report",
      // Markdown の整形は skill の frontmatter を壊すため対象外にする
      "!!**/*.md"
    ]
  },
  "overrides": [
    {
      // Astro のテンプレートで使っている変数は Biome が認識できないので無視する
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    },
    {
      // iframe で埋め込んでいる imgur の embed に対して inline style を上書きするために !important を使っている
      "includes": ["src/styles/global.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
