---
import { NAV_ITEMS, SITE } from "@/site.config";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** トップページではサイト名をページの h1 にする */
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const SiteName = isHome ? "h1" : "p";
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
const linkClass =
  "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors aria-[current=page]:text-gray-900 aria-[current=page]:dark:text-white aria-[current=page]:font-medium";
---

<header class="w-full max-w-5xl mx-auto px-6 lg:px-12 pt-3 pb-2 md:pt-8 md:pb-6">
  <div class="flex items-center justify-between gap-4 py-2">
    <SiteName class="text-xl font-bold tracking-tight">
      <a
        href="/"
        rel="home"
        class="text-gray-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
        >{SITE.name}</a
      >
    </SiteName>

    <div class="flex items-center gap-2 md:gap-6">
      <nav aria-label="メイン" class="hidden md:flex items-center gap-6">
        {
          NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class={linkClass}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />

      <button
        id="menu-toggle"
        type="button"
        class="md:hidden relative w-9 h-9 flex items-center justify-center rounded-md hover:bg-gray-100 dark:hover:bg-neutral-800"
        aria-label="メニュー"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="hamburger-line top-[10px]"></span>
        <span class="hamburger-line top-[17px]"></span>
        <span class="hamburger-line top-[24px]"></span>
      </button>
    </div>
  </div>

  <nav
    id="mobile-menu"
    aria-label="メイン (スマホ)"
    class="md:hidden overflow-hidden max-h-0 opacity-0 transition-all duration-300 ease-in-out"
  >
    <div
      class="flex flex-col gap-1 py-3 border-t border-gray-200 dark:border-darktheme-border"
    >
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class:list={[linkClass, "py-2"]}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            tabindex="-1"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .hamburger-line {
    position: absolute;
    left: 6px;
    width: 24px;
    height: 2px;
    border-radius: 1px;
    background-color: currentColor;
    transition: all 0.3s ease;
  }

  .menu-open #menu-toggle .hamburger-line:nth-child(1) {
    top: 17px;
    transform: rotate(45deg);
  }

  .menu-open #menu-toggle .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .menu-open #menu-toggle .hamburger-line:nth-child(3) {
    top: 17px;
    transform: rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const header = menu?.closest("header");

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    header?.classList.toggle("menu-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    menu.style.maxHeight = open ? `${menu.scrollHeight}px` : "0";
    menu.style.opacity = open ? "1" : "0";
    // 閉じているメニューのリンクに Tab でフォーカスが移らないようにする
    for (const link of menu.querySelectorAll("a")) {
      link.tabIndex = open ? 0 : -1;
    }
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  for (const link of menu?.querySelectorAll("a") ?? []) {
    link.addEventListener("click", () => setOpen(false));
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
