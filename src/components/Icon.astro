const { name, class: className = "w-4 h-4" } = Astro.props;
const icon = ICONS[name];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={icon.fill ? "currentColor" : "none"}
  stroke={icon.fill ? undefined : "currentColor"}
  stroke-width={icon.fill ? undefined : 2}
  stroke-linecap={icon.fill ? undefined : "round"}
  stroke-linejoin={icon.fill ? undefined : "round"}
  aria-hidden="true"
  focusable="false"
>
  <path d={icon.d} fill-rule={icon.fill ? "evenodd" : undefined} clip-rule={icon.fill ? "evenodd" : undefined}></path>
</svg>
