---
import { AUTHOR, NAV_ITEMS, SITE, SOCIAL_LINKS } from "@/site.config";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
const linkClass =
  "text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors";
---

<footer class="border-t border-gray-200 dark:border-darktheme-border mt-20">
  <div class="max-w-5xl mx-auto px-6 lg:px-12 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="space-y-4">
        <a href="/" class="text-xl font-bold dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
          {SITE.name}
        </a>
        <p class="text-sm text-gray-500 dark:text-darktheme-muted max-w-sm leading-relaxed">
          {SITE.description}
        </p>
        <div class="flex items-center gap-4">
          {
            SOCIAL_LINKS.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer me"
                class={linkClass}
                aria-label={link.label}
                title={link.label}
              >
                <Icon name={link.icon} class="w-5 h-5" />
              </a>
            ))
          }
          <a href="/feed.xml" class={linkClass} aria-label="RSS フィード" title="RSS フィード">
            <Icon name="rss" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <nav aria-label="フッター" class="md:text-right">
        <ul class="space-y-2">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a href={item.href} class={linkClass}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="mt-10 text-xs text-gray-400 dark:text-gray-500">
      &copy; {year} {AUTHOR.name}
    </p>
  </div>
</footer>
