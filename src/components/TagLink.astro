---
import { tagHref } from "@/lib/posts";

interface Props {
  tag: string;
  /** タグ一覧などで記事数を添える場合に渡す */
  count?: number;
  class?: string;
}

const { tag, count, class: className } = Astro.props;
---

<a
  href={tagHref(tag)}
  class:list={[
    "relative z-10 inline-flex items-center gap-1 text-xs px-2.5 py-1 rounded-full bg-gray-100 dark:bg-neutral-800 text-gray-700 dark:text-gray-300 hover:bg-indigo-50 hover:text-indigo-700 dark:hover:bg-indigo-950 dark:hover:text-indigo-200 transition-colors",
    className,
  ]}
>
  <span>#{tag}</span>
  {count !== undefined && (
    <span class="text-gray-600 dark:text-gray-400 tabular-nums" aria-label={`${count} 件`}>
      {count}
    </span>
  )}
</a>
