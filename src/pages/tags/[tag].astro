---
import PostList from "@/components/PostList.astro";
import ListLayout from "@/layouts/ListLayout.astro";
import { getPosts, groupByTag } from "@/lib/posts";
import { MIN_POSTS_FOR_INDEXED_TAG, SITE } from "@/site.config";

export async function getStaticPaths() {
  const tags = groupByTag(await getPosts());
  return tags.map((tag) => ({ params: { tag: tag.name }, props: { tag } }));
}

const { tag } = Astro.props;
const title = `${tag.name} の記事`;
---

<ListLayout
  title={title}
  description={`${SITE.name} の「${tag.name}」タグの記事 (${tag.posts.length}件) の一覧です。`}
  crumbs={[{ label: "Tags", href: "/tags/" }, { label: title }]}
  posts={tag.posts}
  noindex={tag.posts.length < MIN_POSTS_FOR_INDEXED_TAG}
>
  <p slot="lead" class="mt-2 text-sm text-gray-500 dark:text-darktheme-muted">
    {tag.posts.length} 件の記事
  </p>
  <PostList posts={tag.posts} headingLevel="h2" />
</ListLayout>
