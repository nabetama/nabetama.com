---
import { render } from "astro:content";
import { mdxComponents } from "@/components/mdx";
import PostLayout from "@/layouts/PostLayout.astro";
import { adjacentPosts, getPosts, relatedPosts } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      related: relatedPosts(post, posts),
      ...adjacentPosts(post, posts),
    },
  }));
}

const { post, related, newer, older } = Astro.props;
const { Content, headings } = await render(post.entry);
---

<PostLayout
  post={post}
  headings={headings}
  related={related}
  newer={newer}
  older={older}
>
  <Content components={mdxComponents} />
</PostLayout>
