---
import PostList from "@/components/PostList.astro";
import ListLayout from "@/layouts/ListLayout.astro";
import { yearOf } from "@/lib/date";
import { getPosts, groupByYear } from "@/lib/posts";
import { SITE } from "@/site.config";

const posts = await getPosts();
const years = groupByYear(posts, yearOf);
---

<ListLayout
  title="Archive"
  description={`${SITE.name} のすべての記事 (${posts.length}件) を新しい順に一覧できます。`}
  crumbs={[{ label: "Archive" }]}
  posts={posts}
>
  <Fragment slot="lead">
    <p class="mt-2 text-sm text-gray-500 dark:text-darktheme-muted">
      全 {posts.length} 件の記事
    </p>
    <nav aria-label="年で移動" class="mt-4">
      <ul class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
        {
          years.map(({ year, posts: inYear }) => (
            <li>
              <a href={`#y${year}`} class="text-indigo-600 dark:text-indigo-300 hover:underline underline-offset-4 tabular-nums">
                {year}
                <span class="text-gray-500 dark:text-gray-400">({inYear.length})</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Fragment>

  {
    years.map(({ year, posts: inYear }) => (
      <section aria-labelledby={`y${year}`} class="mb-10">
        <h2
          id={`y${year}`}
          class="sticky top-0 z-10 py-2 bg-white/90 dark:bg-darktheme-bg/90 backdrop-blur text-lg font-bold tabular-nums text-gray-900 dark:text-white border-b border-gray-200 dark:border-darktheme-border"
        >
          {year}
        </h2>
        <PostList posts={inYear} />
      </section>
    ))
  }
</ListLayout>
