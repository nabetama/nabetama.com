---
import Icon from "@/components/Icon.astro";
import PostCard from "@/components/PostCard.astro";
import PostList from "@/components/PostList.astro";
import TagLink from "@/components/TagLink.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, groupByTag } from "@/lib/posts";
import { HOME, SITE } from "@/site.config";

const posts = await getPosts();
const featured = posts.slice(0, HOME.featured);
const recent = posts.slice(HOME.featured, HOME.total);
const tags = groupByTag(posts).slice(0, 12);
const sectionHeading =
  "text-sm font-bold tracking-wider text-gray-500 dark:text-darktheme-muted mb-4";
---

<BaseLayout>
  <div class="max-w-5xl mx-auto px-6 lg:px-12">
    <p class="mb-8 text-sm text-gray-600 dark:text-darktheme-muted">
      {SITE.description}
    </p>

    <section aria-labelledby="latest-heading" class="mb-12">
      <h2 id="latest-heading" class={sectionHeading}>最新の記事</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {featured.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    {
      recent.length > 0 && (
        <section aria-labelledby="recent-heading" class="mb-12">
          <h2 id="recent-heading" class={sectionHeading}>これまでの記事</h2>
          <PostList posts={recent} />
          <a
            href="/posts/"
            class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-indigo-600 dark:text-indigo-300 hover:underline underline-offset-4"
          >
            すべての記事を見る ({posts.length}件)
            <Icon name="arrow-right" />
          </a>
        </section>
      )
    }

    {
      tags.length > 0 && (
        <section aria-labelledby="tags-heading">
          <h2 id="tags-heading" class={sectionHeading}>タグ</h2>
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <TagLink tag={tag.name} count={tag.posts.length} />
              </li>
            ))}
            <li>
              <a href="/tags/" class="inline-flex text-xs px-2.5 py-1 text-indigo-600 dark:text-indigo-300 hover:underline underline-offset-4">
                すべてのタグ
              </a>
            </li>
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>
