---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import SEO, { type ArticleMeta, type ImageMeta } from "@/components/SEO.astro";
import { type JsonLd, person, website } from "@/lib/structured-data";
import { SITE } from "@/site.config";
import "@/styles/global.css";

interface Props {
  /** ページ固有のタイトル。省略するとサイト名だけになる (トップページ) */
  title?: string;
  description?: string;
  image?: ImageMeta;
  ogType?: "website" | "article";
  article?: ArticleMeta;
  /** 本文の言語。省略時はサイトの言語 */
  lang?: string;
  noindex?: boolean;
  /** ページ固有の構造化データ。WebSite と Person はすべてのページに付く */
  jsonLd?: JsonLd[];
}

const {
  title,
  description = SITE.description,
  image = {
    url: new URL(SITE.defaultOgImage.path, SITE.url).toString(),
    width: SITE.defaultOgImage.width,
    height: SITE.defaultOgImage.height,
    alt: SITE.name,
  },
  ogType = "website",
  article,
  lang = SITE.lang,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const isHome = Astro.url.pathname === "/";
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 描画前にテーマを決め、ダークモードでの白いちらつきを防ぐ -->
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        if (saved === "dark" || (!saved && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={SITE.themeColor.light}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={SITE.themeColor.dark}
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/feed.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <SEO
      title={pageTitle}
      socialTitle={title ?? SITE.name}
      description={description}
      canonical={canonical}
      ogType={ogType}
      image={image}
      article={article}
      noindex={noindex}
      jsonLd={[website(), person(), ...jsonLd]}
    />
    <slot name="head" />
  </head>
  <body
    class="antialiased min-h-screen flex flex-col bg-white dark:bg-darktheme-bg text-gray-800 dark:text-darktheme-font"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:rounded-md focus:bg-white focus:text-gray-900 focus:shadow-lg dark:focus:bg-neutral-800 dark:focus:text-white"
      >本文へスキップ</a
    >
    <Header isHome={isHome} />
    <main id="main" class="grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
