---
import type { MarkdownHeading } from "astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Icon from "@/components/Icon.astro";
import PostList from "@/components/PostList.astro";
import Prose from "@/components/Prose.astro";
import MobileToc from "@/components/post/MobileToc.astro";
import PostNav from "@/components/post/PostNav.astro";
import ShareLinks from "@/components/post/ShareLinks.astro";
import TableOfContents from "@/components/post/TableOfContents.astro";
import TagLink from "@/components/TagLink.astro";
import { formatDate, isoDate } from "@/lib/date";
import type { Post } from "@/lib/posts";
import { blogPosting, breadcrumbList, type Crumb } from "@/lib/structured-data";
import { SITE } from "@/site.config";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  related: Post[];
  newer?: Post;
  older?: Post;
}

const { post, headings, related, newer, older } = Astro.props;

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const crumbs: Crumb[] = [
  { label: "Home", href: "/" },
  { label: "Archive", href: "/posts/" },
  { label: post.title },
];
const url = new URL(post.href, SITE.url).toString();
const isUpdated =
  post.lastModDate && isoDate(post.lastModDate) !== isoDate(post.date);
---

<BaseLayout
  title={post.title}
  description={post.description}
  ogType="article"
  image={{ url: post.ogImage, alt: post.title, large: post.hasOwnImage }}
  article={{
    publishedTime: post.date,
    modifiedTime: post.lastModDate ?? post.date,
    tags: post.tags,
  }}
  jsonLd={[blogPosting(post), breadcrumbList(crumbs, post.href)]}
>
  <MobileToc headings={tocHeadings} />

  <div class="max-w-5xl mx-auto px-6 lg:px-12 pt-6">
    <Breadcrumbs crumbs={crumbs} />

    <div class="xl:grid xl:grid-cols-[minmax(0,1fr)_240px] xl:gap-12">
      <article class="min-w-0 max-w-[42rem] mx-auto xl:mx-0 xl:max-w-none">
        <header class="mb-8">
          <h1 class="text-2xl md:text-3xl font-bold leading-snug tracking-wide text-gray-900 dark:text-white mb-4">
            {post.title}
          </h1>
          <div class="flex items-center flex-wrap gap-x-4 gap-y-2 text-sm text-gray-500 dark:text-darktheme-muted">
            <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time>
            {
              isUpdated && post.lastModDate && (
                <span>
                  更新: <time datetime={isoDate(post.lastModDate)}>{formatDate(post.lastModDate)}</time>
                </span>
              )
            }
            <span class="inline-flex items-center gap-1" title="読了時間の目安">
              <Icon name="clock" class="w-3.5 h-3.5" />
              約{post.readingMinutes}分で読めます
            </span>
          </div>
          {
            post.tags.length > 0 && (
              <ul class="flex flex-wrap gap-1.5 mt-4" aria-label="タグ">
                {post.tags.map((tag) => (
                  <li>
                    <TagLink tag={tag} />
                  </li>
                ))}
              </ul>
            )
          }
        </header>

        <Prose>
          <slot />
        </Prose>

        <footer class="mt-12 pt-8 border-t border-gray-200 dark:border-darktheme-border space-y-10">
          <ShareLinks url={url} title={post.title} />
          <PostNav newer={newer} older={older} />
          {
            related.length > 0 && (
              <section aria-labelledby="related-heading">
                <h2 id="related-heading" class="text-base font-bold text-gray-900 dark:text-white mb-2">
                  関連する記事
                </h2>
                <PostList posts={related} showDescription={false} />
              </section>
            )
          }
          <a
            href="/posts/"
            class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 dark:text-darktheme-muted hover:text-gray-900 dark:hover:text-white transition-colors"
          >
            <Icon name="arrow-left" />
            すべての記事を見る
          </a>
        </footer>
      </article>

      {
        tocHeadings.length > 0 && (
          <aside class="hidden xl:block">
            <div class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto">
              <TableOfContents headings={tocHeadings} />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>
